# ======================================================
# Environment
# ======================================================
ENVIRONMENT=development

# ======================================================
# Database (Supabase PostgreSQL)
# ======================================================
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# ======================================================
# Redis (Local Docker)
# ======================================================
REDIS_URL=redis://localhost:6379/0

# ======================================================
# Storage
# ======================================================
STORAGE_PROVIDER=supabase

UPLOAD_DIR=storage/uploads
REPORT_DIR=storage/reports
ARTIFACT_DIR=storage/artifacts

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

SUPABASE_BUCKET_DATASETS=datasets
SUPABASE_BUCKET_PROCESSED=processed
SUPABASE_BUCKET_MODELS=models
SUPABASE_BUCKET_REPORTS=reports
SUPABASE_BUCKET_ARTIFACTS=artifacts
SUPABASE_BUCKET_VISUALIZATIONS=visualizations
SUPABASE_BUCKET_MANIFESTS=manifests

# ======================================================
# AutoML
# ======================================================
DEFAULT_RANDOM_SEED=42
MAX_PARALLEL_JOBS=4

# ======================================================
# Application
# ======================================================
MAX_UPLOAD_MB=500
LOG_LEVEL=INFO

# ======================================================
# AI Provider
# ======================================================
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
